    {
      "name": "a-preflight-is-answered-and-lists-the-transports",
      "section": "CORS",
      "group": "cors",
      "transport": "options",
      "request_headers": {
        "Origin": "https://damus.io",
        "Access-Control-Request-Method": "QUERY",
        "Access-Control-Request-Headers": "content-type"
      },
      "note": "A form-encoded POST is a simple request and is not preflighted. QUERY is not a safelisted method and will be, so an absent method here is how QUERY support ships broken.",
