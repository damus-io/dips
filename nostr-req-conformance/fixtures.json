      "group": "core",
      "transport": "both",
      "query": "kinds=3063,30063",
      "same_as": "element-order-and-repeats-do-not-change-the-answer",
      "expect": {
        "status": 200,
        "body": "events"
      }
    },
    {
      "name": "an-addressable-query-is-cacheable-for-minutes",
      "section": "Caching",
      "group": "caching",
      "transport": "get",
      "query": "%23d=com.damus.notedeck%400.8.0&authors=79be667ef9dcbbac55a06295ce870b07029bfcdb2dce28d959f2815b16f81798&kinds=30063",
      "note": "The install page's query. Addressable identity is (kind, author, d) and all three are pinned.",
