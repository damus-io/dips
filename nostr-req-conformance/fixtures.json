    {
      "name": "the-post-path-carries-the-same-cache-control",
      "section": "Transports / POST",
      "group": "caching",
      "transport": "post",
      "query": "%23d=com.damus.notedeck%400.8.0&authors=79be667ef9dcbbac55a06295ce870b07029bfcdb2dce28d959f2815b16f81798&kinds=30063",
      "note": "Nothing caches a POST, but computing it identically is what makes the flip to QUERY a routing change.",
